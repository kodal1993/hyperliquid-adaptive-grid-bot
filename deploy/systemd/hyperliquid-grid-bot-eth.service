[Unit]
Description=Hyperliquid Adaptive Grid Bot - LIVE (ETH)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/hyperliquid-adaptive-grid-bot-eth
Environment=ENV_PROFILE=live
Environment=HYPERLIQUID_BOT_LOCK_FILE=/tmp/hyperliquid_live_eth.lock
ExecStart=/root/hyperliquid-adaptive-grid-bot-eth/.venv/bin/python -m src.main
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
