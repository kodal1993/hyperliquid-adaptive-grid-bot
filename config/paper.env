ENV_PROFILE=paper
HL_NETWORK=testnet
PAPER_MODE=true
ENABLE_LIVE_TRADING=false
BASE_LEVERAGE=3
GRID_LEVELS=3
MIN_GRID_LEVELS=2
MAX_GRID_LEVELS=4
VOL_LOW_THRESHOLD=0.003
VOL_HIGH_THRESHOLD=0.012
VOL_EXTREME_THRESHOLD=0.025
TREND_BIAS_BASE=0.70
TREND_BIAS_STRONG=0.80
ORDER_NOTIONAL_USD=50
MAX_ACTIVE_EXPOSURE_USD=500
MIN_ORDER_SIZE=0.0001
MAX_ORDER_SIZE=10
MIN_NOTIONAL_USD=10
MAX_NOTIONAL_PER_TRADE_USD=50
MAX_POSITION_NOTIONAL_USD=500
REGRID_THRESHOLD_PCT=0.003
MIN_GRID_PROFIT_OVER_FEES_PCT=0.0005
MIN_EXPECTED_NET_EDGE_USD=0.00
MIN_EXPECTED_NET_EDGE_PCT=0.0000
MIN_RR_RATIO=1.00
MAX_DRAWDOWN_PCT=0.25
DAILY_LOSS_LIMIT_PCT=0.04
STATE_FILE=state/paper_bot_state.json
EMERGENCY_STOP_FILE=state/STOP_PAPER
HYPERLIQUID_BOT_LOCK_FILE=/tmp/hyperliquid_paper.lock
PAPER_START_BALANCE_USD=500

FILL_MODEL=conservative

# Position cleanup / dust handling
DUST_POSITION_NOTIONAL_USD=1
AUTO_DUST_CLEANUP_USD=5
MIN_RESIDUAL_NOTIONAL_USD=10
STALE_POSITION_MAX_HOURS=12

# Recenter throttling
RECENTER_COOLDOWN_SECONDS=600
POSITION_RECENTER_COOLDOWN_SECONDS=900

# Telegram
TELEGRAM_REPORT_INTERVAL_SECONDS=3600
TELEGRAM_RISK_ALERT_COOLDOWN_SECONDS=3600
TELEGRAM_ENABLE_COMMANDS=true
TELEGRAM_SEND_STARTUP=true
TELEGRAM_SEND_FILLS=true
TELEGRAM_SEND_HARD_RISK_ALERTS=true
TELEGRAM_SEND_STRATEGY_PAUSE_ALERTS=false
TELEGRAM_SEND_PERIODIC_STATUS=true

STALE_ORDER_MAX_AGE_SEC=1800
