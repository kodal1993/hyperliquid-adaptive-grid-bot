ENV_PROFILE=live
HL_NETWORK=mainnet
HL_PRIVATE_KEY=
HL_ACCOUNT_ADDRESS=
HL_DEFAULT_SYMBOL=BTC

# Live-only runtime. Keep limits conservative and validate manually before enabling the service.
PAPER_MODE=false
ENABLE_LIVE_TRADING=true
LIVE_EXECUTION_ENABLED=true

STATE_FILE=state/live_bot_state.json
EMERGENCY_STOP_FILE=state/STOP_LIVE
HYPERLIQUID_BOT_LOCK_FILE=/tmp/hyperliquid_live.lock

BOT_TICK_SECONDS=10
BASE_LEVERAGE=1
LEVERAGE_MIN=1
LEVERAGE_MAX=1

GRID_LEVELS=3
MIN_GRID_LEVELS=2
MAX_GRID_LEVELS=4
VOL_LOW_THRESHOLD=0.003
VOL_HIGH_THRESHOLD=0.012
VOL_EXTREME_THRESHOLD=0.025
TREND_BIAS_BASE=0.70
TREND_BIAS_STRONG=0.80
ORDER_NOTIONAL_USD=20
MAX_ACTIVE_EXPOSURE_USD=110
GRID_SPACING_MULTIPLIER=1.20
GRID_SPACING_MIN_PCT=0.0030
GRID_SPACING_PCT=0.0035
REGRID_THRESHOLD_PCT=0.003
MIN_GRID_PROFIT_OVER_FEES_PCT=0.0005
MIN_EXPECTED_NET_EDGE_USD=0.00
MIN_EXPECTED_NET_EDGE_PCT=0.0000
MIN_RR_RATIO=1.00

# Fee model (Hyperliquid base tier: maker 0.015%, taker 0.045%)
# Grid entries are post-only (Alo), so planning assumes maker-maker roundtrips.
MAKER_FEE_RATE=0.00015
TAKER_FEE_RATE=0.00045
USE_ALO_ORDERS=true

# Trade-history profitability guards
MIN_EXPECTED_NET_PROFIT_FEE_MULTIPLE=2.75
MIN_NET_PROFIT_FEE_MULTIPLIER=2.75
COUNTER_TREND_ENTRY_EDGE_SCORE=3.50
STRONG_MOMENTUM_BLOCK_THRESHOLD=0.65
ADVERSE_MOVE_EXIT_PCT=0.015
# Per-position defensive exits cross as taker and fought the grid mean-reversion
# (live: -$4.67 from 74 taker closes vs +$2.35 maker grid). Widened so the grid
# holds through normal moves; backstop is 1x leverage + max position + market-stress.
WRONG_WAY_EXIT_LOSS_PCT=0.015
# Crash-exit machinery (config-driven; defaults keep the data-following posture).
# POSITION_STOP_LOSS_PCT: regime- and mean-reversion-independent catastrophe backstop.
#   Set to 0 to disable. 0.025 = flatten any position 2.5% underwater no matter what.
#   Deliberately wide: live data shows tight taker stops lose money, so this only
#   catches an unbounded run, not normal grid drawdown.
POSITION_STOP_LOSS_PCT=0.025
# MEAN_REVERSION_OVERRIDE_PCT: once an adverse move reaches this size, the
#   mean-reversion "wait for the bounce" defer is ignored and the adverse-move exit
#   fires anyway. 0 disables the override (pure mean-reversion gating).
MEAN_REVERSION_OVERRIDE_PCT=0.0
MEAN_REVERSION_CONFIRM_BARS=1
# FLATTEN_MAKER_FIRST: forced exits first rest a post-only reduce-only order on our
#   own side of the book (maker fee). If unfilled after FLATTEN_MAKER_WAIT_SECONDS,
#   it escalates to an aggressive taker cross. Makes every defensive exit cheaper.
# Trade-history finding (May 28-Jun 23): 25 taker exits drove the whole net loss,
#   and ~$1.51 of that was pure taker fee that maker exits would have avoided. The
#   8s window let trend-move exits escalate to taker; widened + re-pegged below.
FLATTEN_MAKER_FIRST=true
FLATTEN_MAKER_WAIT_SECONDS=20
# FLATTEN_MAKER_REPEG_PCT: while the maker window is open, re-peg the resting
#   reduce-only exit to the passive touch whenever the mark drifts at least this
#   far from it, so the exit keeps filling at the maker fee as price moves instead
#   of being left behind. 0 disables (one-shot place-then-escalate).
FLATTEN_MAKER_REPEG_PCT=0.0006
MIN_REVERSION_CONFIRMATION_PCT=0.0015
GRID_SPACING_LOW_VOL_MIN_PCT=0.0025
GRID_SPACING_LOW_VOL_MAX_PCT=0.0030
GRID_SPACING_NORMAL_VOL_MIN_PCT=0.0035
GRID_SPACING_NORMAL_VOL_MAX_PCT=0.0045
GRID_SPACING_HIGH_VOL_MIN_PCT=0.0055
GRID_SPACING_HIGH_VOL_MAX_PCT=0.0075
GRID_SPACING_PCT_MIN=0.0030
GRID_SPACING_PCT_MAX=0.0055

MIN_ORDER_SIZE=0.0001
MAX_ORDER_SIZE=10
MIN_NOTIONAL_USD=12
MIN_ORDER_NOTIONAL_USD=12
MAX_NOTIONAL_PER_TRADE_USD=24
MAX_POSITION_NOTIONAL_USD=90

MAX_DRAWDOWN_PCT=0.03
DAILY_LOSS_LIMIT_PCT=0.015
MAX_ONE_DIRECTION_EXPOSURE_PCT=0.30
MAX_DIRECTIONAL_EXPOSURE_PCT=1.00

DUST_POSITION_NOTIONAL_USD=2
DUST_CLEANUP_MODE=reduce_only_once
DUST_CLEANUP_COOLDOWN_SECONDS=300
AUTO_DUST_CLEANUP_USD=5
EXCLUDE_DUST_FROM_PERFORMANCE_STATS=true
MIN_RESIDUAL_NOTIONAL_USD=12
STALE_POSITION_MAX_HOURS=12
STALE_ORDER_MAX_AGE_SEC=1800
# Flat-orphan cleanup needs this many consecutive ticks of a confirmed missing
# side before canceling anything; young orders (< MIN_ORDER_LIFETIME_SECONDS)
# never count as orphans.
ORPHAN_CLEANUP_CONFIRM_TICKS=3

# Fill-rate recovery / anti-churn controls
NO_FILL_WATCHDOG_ENABLED=true
NO_FILL_MAX_MINUTES=60
NO_FILL_SPACING_REDUCTION_PCT=0.20
NO_FILL_MIN_SPACING_PCT=0.0022
MIN_ORDER_LIFETIME_SECONDS=90
MIN_REPRICE_DISTANCE_PCT=0.0015
MAX_ORDER_OPS_PER_CYCLE=2
RATE_LIMIT_COOLDOWN_SECONDS=120
RATE_LIMIT_DEFICIT_COOLDOWN_SECONDS_PER_REQUEST=0.05
RATE_LIMIT_MAX_COOLDOWN_SECONDS=900
RATE_LIMIT_ORPHAN_GRACE_SECONDS=600
# After a cumulative rate-limit rejection, stay in frugal recovery mode this long:
# one order op per cycle, placements before cancels, resting orders kept.
RATE_LIMIT_RECOVERY_WINDOW_SECONDS=1800
# Proactive request-budget watch (public userRateLimit endpoint): poll interval,
# Telegram alert threshold, and the headroom below which frugal mode pre-arms
# without waiting for an exchange rejection.
RATE_LIMIT_BUDGET_POLL_SECONDS=600
RATE_LIMIT_HEADROOM_ALERT=1000
RATE_LIMIT_HEADROOM_FRUGAL=500
# Minimum spacing between exchange actions while in recovery/frugal mode; the
# over-limit trickle accepts ~1 action per 10s, so keep a safety margin.
RATE_LIMIT_MIN_ACTION_INTERVAL_SECONDS=12
# While in deficit, do not chase the price: hold resting orders at least this
# long and only reprice on a move bigger than a full grid spacing.
RATE_LIMIT_RECOVERY_MIN_ORDER_LIFETIME_SECONDS=600
RATE_LIMIT_RECOVERY_MIN_REPRICE_DISTANCE_PCT=0.005
# Hard hourly cap on grid-maintenance exchange actions while in deficit; an
# empty book may always be re-seeded and reduce-only TPs are exempt.
RATE_LIMIT_RECOVERY_MAX_OPS_PER_HOUR=6

RECENTER_COOLDOWN_SECONDS=600
POSITION_RECENTER_COOLDOWN_SECONDS=900


# Telegram is mandatory for live monitoring. Keep secrets only in config/live.env on the VPS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REPORT_INTERVAL_SECONDS=900
TELEGRAM_RISK_ALERT_COOLDOWN_SECONDS=900
TELEGRAM_ENABLE_COMMANDS=true
TELEGRAM_SEND_STARTUP=true
TELEGRAM_SEND_FILLS=true
TELEGRAM_SEND_HARD_RISK_ALERTS=true
TELEGRAM_SEND_STRATEGY_PAUSE_ALERTS=true
TELEGRAM_SEND_PERIODIC_STATUS=true

LOG_LEVEL=INFO

# Regime flip protection
REGIME_CONFIRMATION_BARS=1
REGIME_MIN_CONFIDENCE=0.0
TREND_FLIP_COOLDOWN_TICKS=6
# Time-based floor for the flip cooldown (overrides ticks when longer); the
# 60s tick-based cooldown allowed loss-making flip churn minutes apart.
TREND_FLIP_COOLDOWN_MINUTES=10

# Market Stress Engine Phase 1 (BTC candle data only; conservative defaults for ~325 USD equity)
ENABLE_MARKET_STRESS_FILTER=true
HIGH_VOL_ATR_PCT=0.006
EXTREME_VOL_ATR_PCT=0.010
BTC_5M_SHOCK_PCT=0.008
BTC_1H_SHOCK_PCT=0.025
TREND_STRONG_CONFIDENCE=0.75
TREND_WEAK_CONFIDENCE=0.45
PANIC_SCORE_THRESHOLD=0.80
MARKET_STRESS_EXTREME_FLAT=false
ANTI_CHOP_COOLDOWN_MINUTES=5

# Hyperliquid L2 order book imbalance filter
ORDERBOOK_FILTER_ENABLED=true
ORDERBOOK_SOFT_MODE=true
ORDERBOOK_TOP_N_LEVELS=10
ORDERBOOK_SMOOTHING_SNAPSHOTS=5
ORDERBOOK_MAX_LEVEL_REDUCTION_PCT=0.5
ORDERBOOK_MAX_AGE_SECONDS=5
ORDERBOOK_MIN_SAMPLES=5
ORDERBOOK_COUNTER_EDGE_SCORE=3.50
PREDICTION_LAYER_ENABLED=true
PREDICTION_SOFT_MODE=true
PREDICTION_CONFIDENCE_THRESHOLD=0.65
PREDICTION_MAX_LEVEL_BIAS_PCT=0.5
PREDICTION_MAX_SIZE_MULTIPLIER=1.25
PREDICTION_MIN_SIZE_MULTIPLIER=0.75

# Paired take-profit: each opening grid fill is paired with a reduce-only TP
# one grid spacing away (multiplier scales the TP distance). Post-only first
# keeps the TP maker-rate; it falls back to Gtc when it would cross the book.
PAIRED_TAKE_PROFIT_ENABLED=true
PAIRED_TP_SPACING_MULTIPLIER=1.0
PAIRED_TP_POST_ONLY=true

# Market data over WebSocket (orderbook, candles, user fills) with automatic
# REST fallback when the stream is unavailable or stale.
USE_WEBSOCKET=true
