ENV_PROFILE=live
HL_NETWORK=mainnet
HL_PRIVATE_KEY=
HL_ACCOUNT_ADDRESS=
HL_DEFAULT_SYMBOL=BTC

# Live-only runtime. Keep limits conservative and validate manually before enabling the service.
PAPER_MODE=false
ENABLE_LIVE_TRADING=true
LIVE_EXECUTION_ENABLED=true

STATE_FILE=state/live_bot_state.json
EMERGENCY_STOP_FILE=state/STOP_LIVE
HYPERLIQUID_BOT_LOCK_FILE=/tmp/hyperliquid_live.lock

BOT_TICK_SECONDS=10
BASE_LEVERAGE=1
LEVERAGE_MIN=1
LEVERAGE_MAX=1

GRID_LEVELS=3
MIN_GRID_LEVELS=2
MAX_GRID_LEVELS=4
VOL_LOW_THRESHOLD=0.003
VOL_HIGH_THRESHOLD=0.012
VOL_EXTREME_THRESHOLD=0.025
TREND_BIAS_BASE=0.70
TREND_BIAS_STRONG=0.80
ORDER_NOTIONAL_USD=10
MAX_ACTIVE_EXPOSURE_USD=50
GRID_SPACING_MULTIPLIER=1.20
GRID_SPACING_MIN_PCT=0.0025
GRID_SPACING_PCT=0.0035
REGRID_THRESHOLD_PCT=0.003
MIN_GRID_PROFIT_OVER_FEES_PCT=0.0005
MIN_EXPECTED_NET_EDGE_USD=0.00
MIN_EXPECTED_NET_EDGE_PCT=0.0000
MIN_RR_RATIO=1.00

# Trade-history profitability guards
MIN_EXPECTED_NET_PROFIT_FEE_MULTIPLE=1.50
MIN_NET_PROFIT_FEE_MULTIPLIER=1.50
COUNTER_TREND_ENTRY_EDGE_SCORE=3.50
STRONG_MOMENTUM_BLOCK_THRESHOLD=0.65
ADVERSE_MOVE_EXIT_PCT=0.0045
MIN_REVERSION_CONFIRMATION_PCT=0.0015
GRID_SPACING_LOW_VOL_MIN_PCT=0.0025
GRID_SPACING_LOW_VOL_MAX_PCT=0.0030
GRID_SPACING_NORMAL_VOL_MIN_PCT=0.0035
GRID_SPACING_NORMAL_VOL_MAX_PCT=0.0045
GRID_SPACING_HIGH_VOL_MIN_PCT=0.0055
GRID_SPACING_HIGH_VOL_MAX_PCT=0.0075
GRID_SPACING_PCT_MIN=0.0025
GRID_SPACING_PCT_MAX=0.0055

MIN_ORDER_SIZE=0.0001
MAX_ORDER_SIZE=10
MIN_NOTIONAL_USD=10
MIN_ORDER_NOTIONAL_USD=10
MAX_NOTIONAL_PER_TRADE_USD=12
MAX_POSITION_NOTIONAL_USD=40

MAX_DRAWDOWN_PCT=0.03
DAILY_LOSS_LIMIT_PCT=0.015
MAX_ONE_DIRECTION_EXPOSURE_PCT=0.30
MAX_DIRECTIONAL_EXPOSURE_PCT=1.00

DUST_POSITION_NOTIONAL_USD=2
AUTO_DUST_CLEANUP_USD=5
EXCLUDE_DUST_FROM_PERFORMANCE_STATS=true
MIN_RESIDUAL_NOTIONAL_USD=10
STALE_POSITION_MAX_HOURS=12
STALE_ORDER_MAX_AGE_SEC=1800

RECENTER_COOLDOWN_SECONDS=600
POSITION_RECENTER_COOLDOWN_SECONDS=900


# Telegram is mandatory for live monitoring. Keep secrets only in config/live.env on the VPS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REPORT_INTERVAL_SECONDS=900
TELEGRAM_RISK_ALERT_COOLDOWN_SECONDS=900
TELEGRAM_ENABLE_COMMANDS=true
TELEGRAM_SEND_STARTUP=true
TELEGRAM_SEND_FILLS=true
TELEGRAM_SEND_HARD_RISK_ALERTS=true
TELEGRAM_SEND_STRATEGY_PAUSE_ALERTS=true
TELEGRAM_SEND_PERIODIC_STATUS=true

LOG_LEVEL=INFO

# Regime flip protection
REGIME_CONFIRMATION_BARS=1
REGIME_MIN_CONFIDENCE=0.0
TREND_FLIP_COOLDOWN_TICKS=6

# Market Stress Engine Phase 1 (BTC candle data only; conservative defaults for ~160 USD equity)
ENABLE_MARKET_STRESS_FILTER=true
HIGH_VOL_ATR_PCT=0.006
EXTREME_VOL_ATR_PCT=0.010
BTC_5M_SHOCK_PCT=0.008
BTC_1H_SHOCK_PCT=0.025
TREND_STRONG_CONFIDENCE=0.75
TREND_WEAK_CONFIDENCE=0.45
PANIC_SCORE_THRESHOLD=0.80
MARKET_STRESS_EXTREME_FLAT=false
ANTI_CHOP_COOLDOWN_MINUTES=5

# Hyperliquid L2 order book imbalance filter
ORDERBOOK_FILTER_ENABLED=true
ORDERBOOK_SOFT_MODE=true
ORDERBOOK_TOP_N_LEVELS=10
ORDERBOOK_SMOOTHING_SNAPSHOTS=5
ORDERBOOK_MAX_LEVEL_REDUCTION_PCT=0.5
ORDERBOOK_MAX_AGE_SECONDS=5
ORDERBOOK_MIN_SAMPLES=5
ORDERBOOK_COUNTER_EDGE_SCORE=3.50
