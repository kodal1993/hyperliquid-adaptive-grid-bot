# Core
ENV_PROFILE=paper
HL_NETWORK=testnet
HL_PRIVATE_KEY=
HL_ACCOUNT_ADDRESS=
HL_DEFAULT_SYMBOL=BTC

# Strategy
BOT_TICK_SECONDS=10
LEVERAGE_MIN=3
LEVERAGE_MAX=8
BASE_LEVERAGE=5
GRID_LEVELS=3
MIN_GRID_LEVELS=2
MAX_GRID_LEVELS=4
VOL_LOW_THRESHOLD=0.003
VOL_HIGH_THRESHOLD=0.012
VOL_EXTREME_THRESHOLD=0.025
TREND_BIAS_BASE=0.70
TREND_BIAS_STRONG=0.80
ORDER_NOTIONAL_USD=10
MAX_ACTIVE_EXPOSURE_USD=50
GRID_SPACING_PCT=0.003
GRID_SPACING_VOL_MULTIPLIER=1.2
REGRID_THRESHOLD_PCT=0.003
MIN_GRID_PROFIT_OVER_FEES_PCT=0.0005
MIN_ORDER_SIZE=0.0001
MAX_ORDER_SIZE=10
MIN_NOTIONAL_USD=10
MAX_NOTIONAL_PER_TRADE_USD=10
MAX_POSITION_NOTIONAL_USD=50
MAX_DRAWDOWN_PCT=0.30
DAILY_LOSS_LIMIT_PCT=0.06
EMERGENCY_STOP=false
EMERGENCY_STOP_FILE=state/STOP

# Runtime safety
PAPER_MODE=true
ENABLE_LIVE_TRADING=false

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REPORT_INTERVAL_SECONDS=3600
TELEGRAM_RISK_ALERT_COOLDOWN_SECONDS=3600
TELEGRAM_ENABLE_COMMANDS=true
TELEGRAM_SEND_STARTUP=true
TELEGRAM_SEND_FILLS=true
TELEGRAM_SEND_HARD_RISK_ALERTS=true
TELEGRAM_SEND_STRATEGY_PAUSE_ALERTS=false
TELEGRAM_SEND_PERIODIC_STATUS=true

# Runtime
STATE_FILE=state/bot_state.json
LOG_LEVEL=INFO
PAPER_START_BALANCE_USD=500

FILL_MODEL=conservative

STALE_ORDER_MAX_AGE_SEC=1800
