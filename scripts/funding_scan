#!/usr/bin/env python3
"""
Hyperliquid funding-szkenner — hol fizet tartosan a funding, es hol lehet
delta-semlegesen begyujteni?

A LOGIKA
  A perp funding oraankent fizetodik: ha a rata POZITIV, a longok fizetnek a
  shortoknak. Aki shortolja a perpet ES tartja ugyanazt az eszkozt spoton,
  az irany-semleges, es beszedi a fundingot.

  Ez strukturalisan mas, mint a grid-bot volt:
    - a kifizeto AZONOSITHATO (a longok), es a rata belepes ELOTT lathato
    - a dij EGYSZERI (be- es kilepes), nem minden par percben
      -> 30 napos tartasnal a ~6 bps korbeforduloi dij (2 lab x 2 oldal)
         elhanyagolhato egy evi 20%-os funding mellett

AMIT MER
  1. atlagos es median funding az elmult N napban, evesitve
  2. PERSZISZTENCIA: az orak hany szazalekaban volt pozitiv a rata
     (ez fontosabb, mint az atlag — egy kiugras felhuzza az atlagot,
      de nem lehet ra strategiat epiteni)
  3. szoras — mennyire megbizhato
  4. van-e SPOT par a hedgeleshez Hyperliquidon (enelkul nincs delta-semleges
     valtozat, csak irany-kockazatos)
  5. likviditas (24h forgalom, nyitott kotesallomany)

HASZNALAT (a VPS-en, ahol van halozati eleres):
    python3 funding_scan.py                      # top 40 coin, 30 nap
    python3 funding_scan.py --top 80 --days 60
    python3 funding_scan.py --coins HYPE,TAO,SOL --days 90

Csak stdlib kell.
"""
import argparse, json, statistics, sys, time, urllib.request

API = "https://api.hyperliquid.xyz/info"
HOURS_PER_YEAR = 24 * 365
MAKER_FEE_BPS = 1.5          # egy oldal, egy lab
LEGS_ROUNDTRIP_BPS = 4 * MAKER_FEE_BPS   # perp be+ki, spot be+ki = 6 bps


def post(payload, timeout=25, retries=3):
    for attempt in range(retries):
        try:
            req = urllib.request.Request(
                API, data=json.dumps(payload).encode(),
                headers={"Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return json.load(r)
        except Exception as e:
            if attempt == retries - 1:
                raise
            time.sleep(1.5 * (attempt + 1))


def perp_universe():
    """(coin, 24h forgalom, nyitott kotesallomany USD, aktualis funding) lista."""
    meta, ctxs = post({"type": "metaAndAssetCtxs"})
    out = []
    for asset, ctx in zip(meta["universe"], ctxs):
        if asset.get("isDelisted"):
            continue
        try:
            mid = float(ctx.get("midPx") or 0)
            vol = float(ctx.get("dayNtlVlm") or 0)
            oi = float(ctx.get("openInterest") or 0) * mid
            fund = float(ctx.get("funding") or 0)
        except (TypeError, ValueError):
            continue
        if mid > 0:
            out.append({"coin": asset["name"], "vol": vol, "oi": oi,
                        "funding_now": fund})
    out.sort(key=lambda x: -x["vol"])
    return out


def spot_hedgeable():
    """USDC-ben jegyzett spot parok bazis-token nevei (ezeket lehet hedgelni)."""
    try:
        sm = post({"type": "spotMeta"})
    except Exception:
        return set()
    names = {}
    for i, tok in enumerate(sm.get("tokens", [])):
        names[tok.get("index", i)] = tok.get("name", "")
    base = set()
    for pair in sm.get("universe", []):
        toks = pair.get("tokens") or []
        if len(toks) == 2:
            b, q = names.get(toks[0], ""), names.get(toks[1], "")
            if q in ("USDC", "USDT"):
                base.add(b)
    return base


def funding_history(coin, days):
    """Orankenti funding ratak az elmult `days` napra (lapozassal)."""
    end = int(time.time() * 1000)
    start = end - days * 86400 * 1000
    rates, cursor, guard = [], start, 0
    while cursor < end and guard < 12:
        guard += 1
        try:
            chunk = post({"type": "fundingHistory", "coin": coin,
                          "startTime": cursor, "endTime": end})
        except Exception:
            break
        if not chunk:
            break
        for rec in chunk:
            try:
                rates.append((int(rec["time"]), float(rec["fundingRate"])))
            except (KeyError, TypeError, ValueError):
                pass
        last = max(r[0] for r in rates) if rates else cursor
        if last <= cursor:
            break
        cursor = last + 1
        time.sleep(0.25)
    # duplikatumok kiszurese ido szerint
    seen, uniq = set(), []
    for ts, r in sorted(rates):
        if ts not in seen:
            seen.add(ts)
            uniq.append(r)
    return uniq


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--top", type=int, default=40, help="hany coin forgalom szerint")
    ap.add_argument("--coins", type=str, default="", help="konkret lista, vesszovel")
    ap.add_argument("--days", type=int, default=30, help="visszatekintes napokban")
    ap.add_argument("--min-vol", type=float, default=2e6, help="min 24h forgalom USD")
    ap.add_argument("--hold-days", type=int, default=30, help="feltetelezett tartas a netto szamitashoz")
    args = ap.parse_args()

    print("Univerzum lekerese...", file=sys.stderr)
    uni = perp_universe()
    umap = {u["coin"]: u for u in uni}
    hedge = spot_hedgeable()
    print(f"  {len(uni)} perp, {len(hedge)} hedgelheto spot par", file=sys.stderr)

    if args.coins:
        coins = [c.strip() for c in args.coins.split(",") if c.strip()]
    else:
        coins = [u["coin"] for u in uni if u["vol"] >= args.min_vol][: args.top]

    rows = []
    for i, c in enumerate(coins, 1):
        print(f"  [{i}/{len(coins)}] {c}", file=sys.stderr)
        h = funding_history(c, args.days)
        if len(h) < 24 * max(3, args.days // 10):
            continue
        mean_ann = statistics.mean(h) * HOURS_PER_YEAR * 100
        med_ann = statistics.median(h) * HOURS_PER_YEAR * 100
        pos_pct = sum(1 for r in h if r > 0) / len(h) * 100
        sd_ann = (statistics.pstdev(h) * HOURS_PER_YEAR * 100) if len(h) > 1 else 0
        u = umap.get(c, {})
        # netto becsles a feltetelezett tartasra, a ket lab dijaval
        gross = mean_ann * args.hold_days / 365
        fee = LEGS_ROUNDTRIP_BPS / 100
        net_hold = gross - fee
        net_ann = net_hold * 365 / args.hold_days
        rows.append({
            "coin": c, "mean": mean_ann, "med": med_ann, "pos": pos_pct,
            "sd": sd_ann, "net": net_ann, "hedge": c in hedge,
            "vol": u.get("vol", 0), "oi": u.get("oi", 0),
            "now": u.get("funding_now", 0) * HOURS_PER_YEAR * 100,
            "n": len(h),
        })
        time.sleep(0.2)

    # rangsor: perszisztens, pozitiv funding elorol
    rows.sort(key=lambda r: -(r["med"] if r["pos"] > 55 else -999))

    print(f"\n{'COIN':<10}{'vol M$':>9}{'OI M$':>8}{'atlag%':>9}{'median%':>9}"
          f"{'poz.ora%':>10}{'szoras%':>9}{'most%':>8}{'netto%':>9}{'spot':>6}  ITELET")
    print("-" * 104)
    for r in rows:
        if r["med"] > 10 and r["pos"] > 70 and r["hedge"]:
            v = "ERDEMES (hedgelheto)"
        elif r["med"] > 10 and r["pos"] > 70:
            v = "jo rata, DE nincs spot hedge"
        elif r["med"] > 5 and r["pos"] > 60:
            v = "hatareset"
        elif r["med"] < -10 and r["pos"] < 30:
            v = "forditott (shortok fizetnek)"
        else:
            v = "nem perszisztens"
        print(f"{r['coin']:<10}{r['vol']/1e6:>9.1f}{r['oi']/1e6:>8.1f}"
              f"{r['mean']:>9.1f}{r['med']:>9.1f}{r['pos']:>10.1f}{r['sd']:>9.1f}"
              f"{r['now']:>8.1f}{r['net']:>9.1f}{'igen' if r['hedge'] else '-':>6}  {v}")

    print(f"""
MAGYARAZAT
  atlag% / median%  — evesitett funding ({args.days} nap, oraankenti ratakbol).
                      A MEDIAN a megbizhatobb: egy kiugras az atlagot felhuzza.
  poz.ora%          — az orak hany szazalekaban volt pozitiv a rata.
                      EZ A PERSZISZTENCIA. 70% alatt nem strategia, csak zaj.
  szoras%           — evesitett szoras. Nagy ertek = kiszamithatatlan.
  most%             — az aktualis rata evesitve (pillanatkep, nem trend).
  netto%            — {args.hold_days} napos tartast feltetelezve, a ket lab
                      {LEGS_ROUNDTRIP_BPS:.0f} bps korbeforduloi dijat levonva, ujra evesitve.
  spot              — van-e USDC-s spot par a delta-semleges hedgeleshez.
                      Enelkul csak irany-kockazatos valtozat letezik.

MIRE FIGYELJ
  * A magas funding gyakran EGYUTT JAR a kockazattal: uj, illikvid, vagy eppen
    felkapott coinokon a legmagasabb — ott a spot oldal is dragabb es a likvidalasi
    kockazat nagyobb.
  * A funding MEGFORDULHAT. A perszisztencia (poz.ora%) az egyetlen vedelem, es az
    is csak visszatekinto.
  * A delta-semleges valtozat KETTEOSZTJA a tokét (perp margin + spot pozicio),
    tehat a tenyleges tokearanyos hozam nagyjabol a fele a tablazatban lathatonak.
  * Ez a szkript CSAK MER. Nem ad megbizast, nem nyit poziciot.
""")


if __name__ == "__main__":
    main()
